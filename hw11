import java.util.Scanner;

public class JavaApplication23 {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.println("Enter n:");
        int n = input.nextInt();

        for (int i = 1; i <= n; i++) {
            boolean prime = true;

            if (i == 1) {
                prime = false;
            }

            for (int n = 2; n < i; n++) {
                if (i % n == 0) {
                    prime = false;
                    break;
                }
            }

            if (prime) {
                System.out.println(i);
            }
        }
    }
}







